{
  "name": "auctus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3105",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3105",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "owner": "node --env-file-if-exists=.env.local --import tsx scripts/owner.ts",
    "backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "setup": "tsx scripts/setup.ts",
    "format": "prettier --write src scripts tests e2e migrations *.ts *.mjs *.json *.yaml"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popper": "1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "better-auth": "1.7.10",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.21.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
